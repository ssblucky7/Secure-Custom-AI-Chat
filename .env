# ── Server ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY=0
# Keep 0 on public hosting. Set 1 only for trusted local Ollama/LM Studio use.
ALLOW_PRIVATE_PROVIDER_URLS=0

# ── Default provider (optional) ───────────────────────────
# OpenAI-compatible base URL + API key used when the client
# does not supply its own. Leave empty for now — it will be
# configured in the browser UI instead.
AI_API_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
# AI_ALLOWED_MODELS=model-a,model-b

# Cap on max_tokens per chat request (1–100000)
AI_MAX_TOKENS_LIMIT=16384

# ── Provider access policy ────────────────────────────────
# Set 1 to let clients supply their own base URL + API key.
# The key never reaches the browser — the server proxies requests.
ALLOW_USER_PROVIDERS=1

# ── File uploads ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_FILES=10
# UPLOAD_DIR=./uploads