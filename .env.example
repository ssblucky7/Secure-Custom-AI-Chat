# ─────────────────────────────────────────────────────────────
# Secure Custom AI Chat — Server configuration
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────

# Port and host the server binds to
PORT=3000
HOST=0.0.0.0

# NODE_ENV=production enables prod caching etc.
NODE_ENV=development

# Trust X-Forwarded-* headers (set 1 when behind a reverse proxy)
TRUST_PROXY=0

# ── Default provider (optional if ALLOW_USER_PROVIDERS=1) ──
# OpenAI-compatible base URL, e.g.:
#   https://api.openai.com/v1
#   https://api.anthropic.com            (protocol selects /v1/messages automatically)
#   http://localhost:11434/v1            (Ollama — requires ALLOW_PRIVATE_PROVIDER_URLS=1)
AI_API_URL=
AI_API_KEY=

# Default model offered when the user hasn't chosen one
AI_DEFAULT_MODEL=

# Comma-separated extra models listed in the model picker
# AI_ALLOWED_MODELS=

# Cap on max_tokens per chat request (1–100000)
# AI_MAX_TOKENS_LIMIT=8192

# ── Provider access policy ──────────────────────────────────
# Set 1 to let clients supply their own base URL + API key.
# The key never reaches the browser — the server proxies requests.
ALLOW_USER_PROVIDERS=0

# Set 1 only for trusted local development (Ollama / LM Studio / LiteLLM).
# Blocks all private/localhost addresses when 0 (SSRF protection).
ALLOW_PRIVATE_PROVIDER_URLS=0

# ── File uploads ────────────────────────────────────────────
# Max size per file (1–100 MB) and max files per request (1–20)
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_FILES=10

# Where uploaded (temporary) files are stored
# UPLOAD_DIR=./uploads